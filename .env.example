# Copy to .env and fill in real values. Never commit .env.
PINECONE_API_KEY=
PINECONE_INDEX=
GROQ_API_KEY=
LOG_LEVEL=INFO

# Optional error tracking. Sentry stays disabled unless SENTRY_DSN is set,
# so local development needs none of these.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Fraction of requests traced (0-1); 0 disables performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0
